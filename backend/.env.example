# Local Spring properties. Copy to .env.local in this backend directory.
# Never commit .env.local. Values do not need surrounding quotes.
DB_USERNAME=root
DB_PASSWORD=your-local-database-password
# HS512 needs at least 64 UTF-8 bytes. Generate a unique random local key.
APP_JWT_SECRET=replace-with-your-own-random-secret-of-at-least-64-characters
# Optional teacher assistant using native Gemini generateContent and structured JSON.
# Keep the key on this backend only; restart after configuring.
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
